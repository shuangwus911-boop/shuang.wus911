# Supabase 数据库配置
# 在 https://supabase.com 创建项目后获取

# 前端使用 (NEXT_PUBLIC_ 前缀会暴露在客户端，仅用于只读 anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 后端爬虫使用 (service_role key 有完全写权限，绝不可暴露在前端)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 钉钉机器人 Token（可选）
# 用于接收每日选品报告通知
DINGTALK_TOKEN=

# AliExpress API Key（可选，不填则使用免费抓取）
# 在 https://serpapi.com 申请
AE_API_KEY=

# Chrome 浏览器路径（可选，不填则自动检测）
# 用于 puppeteer-core 启动浏览器
CHROME_PATH=
